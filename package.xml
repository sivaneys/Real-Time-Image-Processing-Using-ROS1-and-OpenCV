<?xml version="1.0"?>
<package format="2">
  <name>image_processing_project</name>
  <version>0.0.1</version>
  <description>
    Real-Time Image Processing using ROS 1 and OpenCV.
    Subscribes to the TurtleBot3 simulated camera feed in Gazebo and
    runs face/object detection on each frame using cv_bridge + OpenCV.
  </description>

  <maintainer email="you@example.com">Sivaney</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>image_transport</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <export></export>
</package>
